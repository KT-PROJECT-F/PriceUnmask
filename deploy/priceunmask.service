[Unit]
Description=PriceUnmask API
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/PriceUnmask
Environment="PATH=/home/ubuntu/PriceUnmask/.venv/bin"
ExecStart=/home/ubuntu/PriceUnmask/.venv/bin/uvicorn backend.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target