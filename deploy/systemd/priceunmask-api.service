[Unit]
Description=PriceUnmask FastAPI application
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=priceunmask
Group=priceunmask
WorkingDirectory=/opt/priceunmask/current
EnvironmentFile=/etc/priceunmask/priceunmask.env
ExecStart=/opt/priceunmask/venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
